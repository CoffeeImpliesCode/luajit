// SPDX-License-Identifier: MIT
.{
    // Package name used by `b.dependency("luajit", ...)`.
    .name = .luajit,
    // The rolling version is generated from the packaged `.relver` stamp.
    .version = "2.1.1788856981",
    .fingerprint = 0xda4bba66d6f9ca25,
    .minimum_zig_version = "0.17.0",
    // Native sources and generators are vendored; no package dependencies.
    .dependencies = .{},

    .paths = .{
        "build.zig",
        "build.zig.zon",
        // `cross-test` reads this settings profile from the package root.
        "cross-test.profile.sh",
        "build_support",
        "Makefile",
        "src/Makefile",
        "src/Makefile.dep",
        "src",
        // Upstream's pkg-config template and rolling-version inputs.
        "dynasm",
        "etc",
        ".relver",
        ".gitattributes",
        "doc",
        "README",
        "README.upstream.md",
        // Upstream copyright and licence text.
        "COPYRIGHT",
        // Runtime-loading sources for the optional loader path.
        "runtime",
        "zig",
        // Keep consumer sources explicit so its build outputs stay outside paths.
        "tests.zig",
        "smoke.zig",
        "consumer/build.zig",
        "consumer/build.zig.zon",
        "consumer/src/main.zig",
        // Fork-owned build and ignore rules.
        ".gitignore",
        // Fork documentation, provenance, and package definitions.
        "README.md",
        "README.zig.md",
        "UPSTREAM.md",
        "UPSTREAM.sha256",
        "FORK-NOTES.md",
        "FORK-LICENSE.md",
        "NOTICE.md",
        "CHANGELOG.md",
        "package.nix",
        "flake.nix",
        "flake.lock",
        "devenv.nix",
        "devenv.yaml",
        ".envrc",
        // Generated outputs stay in the cache, not in vendored `src/`.
    },
}
