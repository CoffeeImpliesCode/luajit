# direnv entry point for the canonical devenv shell.
#
# `devenv direnvrc` prints the integration from the devenv that is already
# installed, so this file pins no URL and no hash of its own: there is nothing
# here that could drift away from the tool that will read it.
#
# `use devenv` accepts the same options as `devenv shell`; `--quiet` silences
# it. Neither `DOTFILE` nor `--dotfile` is used: the shell CLI has no
# `--dotfile` option, and `DEVENV_ROOT`, `DOTFILE` and `STATE` are read-only.
#
# Scratch is the caller's business. This file does not set and does not unset
# `TMPDIR`, `ZIG_GLOBAL_CACHE_DIR`, `ZIG_LOCAL_CACHE_DIR`, `DEVENV_HOME`,
# `XDG_RUNTIME_DIR` or `HOST_SCRATCH_ROOT`: a caller who has already pointed
# them at approved storage keeps those settings, and a caller who has not gets
# the toolchain's own defaults. direnv's own default socket base stays /tmp
# unless `XDG_RUNTIME_DIR` says otherwise.

export DIRENV_WARN_TIMEOUT=20s

eval "$(devenv direnvrc)"

use devenv